CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL_TINY=y
CONFIG_LIBNL20=y

CFLAGS += -I$(STAGEDIR)/include/libnl-tiny
CFLAGS += -D_GNU_SOURCE
LIBS += -L$(STAGEDIR)/lib

CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_MD5=y
CONFIG_WPA=y
CONFIG_BACKEND=file

CONFIG_CTRL_IFACE=unix
CONFIG_BGSCAN_SIMPLE=y
CONFIG_DEBUG_FILE=y

#CONFIG_NO_STDOUT_DEBUG=y
CONFIG_NO_CONFIG_WRITE=y
CONFIG_NO_CONFIG_BLOBS=y
